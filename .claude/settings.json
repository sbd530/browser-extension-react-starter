{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run build:firefox)",
      "Bash(npm run build:all)",
      "Bash(npm run compile)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test)",
      "Bash(npm run test:coverage)",
      "Bash(npm run doctor)",
      "Bash(npm run zip)",
      "Bash(npm run zip:firefox)",
      "Bash(npx wxt prepare)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
